{[template "backend/common/header.tmpl" .]}


<div class="layui-fluid">
    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div id="list"></div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;

var tableIns, tableData = [];

tableIns = table.render({
    elem: '#list',
    url: '/{[.admin_path]}/monitor/log/list',
    title: '数据表',
    cols: [[
        {field:'id', title:'ID', width:80},
        {field:'monitor_id', title:'监控ID', width:100},
        {field:'day', title:'日期', width:120, templet: function(d){return String(d.day).replace(/(\d{4})(\d{2})(\d{2})/, '$1-$2-$3')}},
        {field:'time', title:'时间', width:100, templet: function(d){return String(d.hour).padStart(2,'0')+':'+String(d.minute).padStart(2,'0')}},
        {field:'is_connect', title:'状态', width:80, templet: function(d){return d.is_connect?'<span style="color:green">正常</span>':'<span style="color:red">失败</span>'}},
        {field:'size', title:'大小(B)', width:100},
        {field:'speed', title:'耗时(ms)', width:100},
        {field:'error_msg', title:'错误信息', width:200},
        {title:'操作', toolbar: '#cmdTpl', width:120, fixed: 'right'}
    ]],
    page: true,
    done: function(res, curr, count){
    }
});

///
});
</script>

<script type="text/html" id="cmdTpl">
<a class="layui-btn layui-btn-danger layui-btn-xs" lay-event='delete' onclick="Admin.del(this, '/{[$.admin_path]}/monitor/log/delete','{{d.id}}')">删除</a>
</script>

{[template "backend/common/footer.tmpl" .]}
